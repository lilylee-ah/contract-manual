<script>
(function () {
  /* ---------- tabs ---------- */
  var tabs = Array.prototype.slice.call(document.querySelectorAll('[role=tab]'));
  var panels = Array.prototype.slice.call(document.querySelectorAll('[role=tabpanel]'));

  function activate(id, focus) {
    tabs.forEach(function (t) {
      var on = t.id === id;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
      if (on && focus) { t.focus(); }
    });
    panels.forEach(function (p) {
      p.hidden = p.getAttribute('aria-labelledby') !== id;
    });
    try { history.replaceState(null, '', '#' + id.replace('tab-', '')); } catch (e) {}
  }

  tabs.forEach(function (t, i) {
    t.tabIndex = t.getAttribute('aria-selected') === 'true' ? 0 : -1;
    t.addEventListener('click', function () { activate(t.id, false); window.scrollTo({ top: 0 }); });
    t.addEventListener('keydown', function (e) {
      var d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      activate(tabs[(i + d + tabs.length) % tabs.length].id, true);
    });
  });

  var hash = (location.hash || '').replace('#', '');
  if (hash && document.getElementById('tab-' + hash)) { activate('tab-' + hash, false); }

  /* ---------- checklists ---------- */
  function wireList(root, key, counterId, fillId, barId, resetId) {
    var boxes = Array.prototype.slice.call(root.querySelectorAll('input[type=checkbox]'));
    if (!boxes.length) return;
    var saved = {};
    try { saved = JSON.parse(localStorage.getItem(key)) || {}; } catch (e) { saved = {}; }

    function render() {
      var n = 0;
      boxes.forEach(function (b) {
        var li = b.closest('li.step');
        if (b.checked) { n++; if (li) li.classList.add('done'); }
        else if (li) { li.classList.remove('done'); }
      });
      if (counterId) { var c = document.getElementById(counterId); if (c) c.textContent = n; }
      if (fillId) { var f = document.getElementById(fillId); if (f) f.style.width = (n / boxes.length * 100) + '%'; }
      if (barId) { var bb = document.getElementById(barId); if (bb) bb.setAttribute('aria-valuenow', String(n)); }
    }

    boxes.forEach(function (b) {
      if (saved[b.dataset.id]) { b.checked = true; }
      b.addEventListener('change', function () {
        saved[b.dataset.id] = b.checked;
        try { localStorage.setItem(key, JSON.stringify(saved)); } catch (e) {}
        render();
      });
    });

    if (resetId) {
      var r = document.getElementById(resetId);
      if (r) r.addEventListener('click', function () {
        boxes.forEach(function (b) { b.checked = false; });
        saved = {};
        try { localStorage.removeItem(key); } catch (e) {}
        render();
      });
    }
    render();
  }

  wireList(document.getElementById('p-sale'), 'uz-sale-v2', 'saleDone', 'saleFill', 'saleBar', 'saleReset');
  var ho = document.getElementById('handover');
  if (ho) wireList(ho, 'uz-handover-v2', null, null, null, null);

  /* ---------- deadline filter ---------- */
  var fi = document.getElementById('dlFilter');
  if (fi) {
    var rows = Array.prototype.slice.call(document.querySelectorAll('#dlTable tbody tr'));
    var out = document.getElementById('dlCount');
    fi.addEventListener('input', function () {
      var q = fi.value.trim().toLowerCase();
      var n = 0;
      rows.forEach(function (r) {
        var hit = !q || r.textContent.toLowerCase().indexOf(q) !== -1;
        r.style.display = hit ? '' : 'none';
        if (hit) n++;
      });
      out.textContent = q ? (n + '건 표시 중 (전체 ' + rows.length + '건)') : '';
    });
  }

  /* ---------- D-day ---------- */
  function startOfDay(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
  var today = startOfDay(new Date());
  Array.prototype.slice.call(document.querySelectorAll('[data-dday]')).forEach(function (el) {
    var parts = el.getAttribute('data-dday').split('-');
    var target = new Date(+parts[0], +parts[1] - 1, +parts[2]);
    var diff = Math.round((target - today) / 86400000);
    var label, cls;
    if (diff > 0) { label = 'D-' + diff + ' · ' + diff + '일 남음'; cls = diff <= 90 ? 'orange' : ''; }
    else if (diff === 0) { label = 'D-day · 오늘'; cls = 'red'; }
    else { label = 'D+' + Math.abs(diff) + ' · 경과'; cls = 'red'; }
    el.innerHTML = '<span class="pill ' + cls + '">' + label + '</span>';
  });

  /* ---------- business day calculator ---------- */
  var run = document.getElementById('calcRun');
  if (run) {
    var startEl = document.getElementById('calcStart');
    var nEl = document.getElementById('calcN');
    var outEl = document.getElementById('calcOut');
    var iso = function (d) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    };
    var week = ['일', '월', '화', '수', '목', '금', '토'];
    startEl.value = iso(today);

    run.addEventListener('click', function () {
      if (!startEl.value) { outEl.innerHTML = '<p class="muted" style="margin:0">기산일을 선택하세요.</p>'; return; }
      var p = startEl.value.split('-');
      var d = new Date(+p[0], +p[1] - 1, +p[2]);
      var cfg = nEl.value.split('|');
      var n = +cfg[0], mode = cfg[1];
      var label = nEl.options[nEl.selectedIndex].text;

      if (mode === 'c') {
        d.setDate(d.getDate() + n);
      } else {
        var left = n;
        while (left > 0) {
          d.setDate(d.getDate() + 1);
          var w = d.getDay();
          if (w !== 0 && w !== 6) left--;
        }
      }
      var diff = Math.round((startOfDay(d) - today) / 86400000);
      var rel = diff > 0 ? 'D-' + diff : diff === 0 ? 'D-day' : 'D+' + Math.abs(diff);
      outEl.innerHTML =
        '<div class="kpi blue">' + iso(d) + ' (' + week[d.getDay()] + ')</div>' +
        '<p class="small" style="margin:0 0 6px">' + label + '</p>' +
        '<p class="small muted" style="margin:0">오늘 기준 ' + rel + ' · ' +
        (mode === 'c' ? '역일 계산' : '토·일 제외 영업일 계산 — 공휴일은 별도 반영') + '</p>';
    });
  }
})();
</script>
</body>
</html>
